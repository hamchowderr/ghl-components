# =============================================================================
# GHL Components - Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local
#
# IMPORTANT FORMAT NOTES:
# - Do NOT wrap values in quotes (no "value" or 'value')
# - Do NOT add trailing spaces after values
# - URLs must include https:// protocol
# - URLs must NOT have trailing slashes
# - Values are case-sensitive
# =============================================================================

# -----------------------------------------------------------------------------
# GoHighLevel OAuth Configuration
# -----------------------------------------------------------------------------

# Your GHL Marketplace App Client ID (public, safe for browser)
# Format: alphanumeric string
NEXT_PUBLIC_GHL_CLIENT_ID=

# Your GHL Marketplace App Client Secret (server-side only, NEVER expose to browser)
# Format: alphanumeric string
GHL_CLIENT_SECRET=

# OAuth redirect URI - must match exactly what's configured in GHL Marketplace
# Format: https://your-domain.com/api/auth/callback/ghl (no trailing slash)
NEXT_PUBLIC_GHL_REDIRECT_URI=

# -----------------------------------------------------------------------------
# GoHighLevel Location Configuration
# -----------------------------------------------------------------------------

# Your GHL Location/Sub-Account ID (server-side only)
# Format: alphanumeric string (e.g., abc123DEF456)
GHL_LOCATION_ID=

# -----------------------------------------------------------------------------
# Application Configuration (Optional)
# -----------------------------------------------------------------------------

# Node environment (development | production | test)
# NODE_ENV=development

# Base URL for the application (used for webhook callback URLs, etc.)
# Format: https://your-domain.com (no trailing slash)
# NEXT_PUBLIC_APP_URL=http://localhost:3000
